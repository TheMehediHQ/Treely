  "buildCommand": "bun run build",
  "outputDirectory": "packages/client/dist",
  "rewrites": [
    { "source": "/plants", "destination": "/api/index.js" },
    { "source": "/plants/:path*", "destination": "/api/index.js" },
    { "source": "/plants-update/:path*", "destination": "/api/index.js" }
  ]
}
