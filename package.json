{
  "name": "trelly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter '@trelly/server' dev",
    "dev:client": "bun run --filter '@trelly/client' dev",
    "build:server": "bun run --filter '@trelly/server' build",
    "build:client": "bun run --filter '@trelly/client' build",
    "dev": "bun run --filter '*' dev"
  }
}
