{
  "name": "trelly",
  "version": "1.0.0",
  "private": true,
  "description": "Trelly — a plant care tracking and management web application",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheMehediHQ/Treely.git"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "npm run dev --workspace=@trelly/web",
    "dev:server": "npm run dev --workspace=@trelly/server",
    "build:web": "npm run build --workspace=@trelly/web"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
